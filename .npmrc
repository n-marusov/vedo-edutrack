# pnpm v11: packages allowed to run postinstall build scripts.
# The old "allowBuilds" in pnpm-workspace.yaml and "only-built-dependencies"
# in .npmrc are deprecated in v11. Use pnpm.onlyBuiltDependencies instead.
pnpm.onlyBuiltDependencies[]=@biomejs/biome
pnpm.onlyBuiltDependencies[]=esbuild
pnpm.onlyBuiltDependencies[]=lefthook
