# VEDO EduTrack dev-stack environment (root .env.dev).
#
# Copy to .env.dev and adjust: `cp .env.dev.example .env.dev`.
# Every variable has a default in docker-compose.yml / backend config, so the
# file is optional — but it is the primary env source for `make up/dev` and is
# passed to docker compose via `--env-file .env.dev` (see Makefile ENV_FILE).
# Values must be KEY=VALUE (one per line, no quotes).
#
# .env.dev is git-ignored (see .gitignore `.env.*`).

# --- Ports (host side) ---
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_OTLP_GRPC_PORT=4317
OTEL_OTLP_HTTP_PORT=4318
TRAEFIK_DASHBOARD_PORT=8082

# --- PostgreSQL ---
POSTGRES_USER=edutrack
POSTGRES_PASSWORD=edutrack
POSTGRES_DB=edutrack

# --- Grafana (dev only) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Observability / OTel ---
LOG_LEVEL=debug
OTEL_SAMPLING_RATIO=0.1

# --- Dynamic runtime config (ADR-DES.INFRA.dynamic-config-injection) ---
# Backend (compose) — читаются из env при старте:
# PUBLIC_BASE_URL=http://localhost:8080
# VEDO_HUB_API_URL=http://localhost:8081
# VEDO_HUB_GRAPHQL_PATH=/graphql   # путь ontology-service GraphQL (по умолчанию /graphql)
# VEDO_HUB_BEARER_TOKEN=           # опциональный read-only Bearer-токен Hub (пусто = без авторизации)
#
# Frontend (nginx-образ / Go-embed) — пробрасываются при старте контейнера:
#   APP_VERSION=0.1.0        # версия сборки (в nginx-образе — ARG VERSION по умолчанию)
#   APP_ENV=development      # development | staging | production
#   API_BASE_URL=/api/v1     # базовый URL API (backend отдаёт API под /api/v1)

# --- Traefik (Let's Encrypt) ---
# ACME_EMAIL=admin@example.com
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
