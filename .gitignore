# ===== Node / pnpm (вспомогательный тулинг, воркспейс) =====
node_modules/
.pnpm-store/
*.tsbuildinfo

# pnpm-lock.yaml и pnpm-workspace.yaml живут ТОЛЬКО в корне воркспейса;
# случайные копии в подпапках (напр. от pnpm/npm в контейнере) игнорируем.
frontend/pnpm-lock.yaml
frontend/pnpm-workspace.yaml
frontend/package-lock.json

# ===== Временные вспомогательные файлы (agent tooling) =====
.tmp-*
.tmp-*/
.playwright-mcp/

# ===== E2E (Playwright) =====
playwright-report/
test-results/

# ===== Сборка / артефакты =====
dist/
build/
out/
coverage/
.vite/

# ===== Логи =====
*.log
npm-debug.log*
pnpm-debug.log*

# ===== Секреты и окружение =====
.env
.env.*
!.env.example
# Non-secret dev/test stack env (committed defaults) — see deploy/README.md.
!deploy/.env.dev
!deploy/.env.test
!backend/.env.example

# ===== ОС =====
.DS_Store
Thumbs.db

# ===== Go (будущий бэкенд) =====
/bin/
**/bin/
backend/tmp/
*.exe
*.test
!deploy/.env.test
coverage.out
backend-sbom.spdx.json
.zed/settings.json
deploy/.env.dev
deploy/.env.test

# ===== Python (uv / dev tooling) =====
# Виртуальное окружение uv (создаётся командой `uv venv`, активация .venv\Scripts\activate)
.venv/

# Кэши интерпретатора и тулинга
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv/

# Артефакты сборки/пакетов
*.egg-info/
*.whl
*.egg
.coverage
.coverage.*
htmlcov/
