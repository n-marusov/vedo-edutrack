# VEDO EduTrack test-stack environment (deploy/.env.test).
#
# Non-secret dev/test defaults (edutrack/edutrack — local only). Passed to the
# TEST compose stack via `make test-up` (--env-file deploy/.env.test) or
# deploy/ci/e2e-run.sh. Every variable has a default in
# docker-compose.test.yml, so the file is optional — but it centralizes the
# test-stack configuration.
#
# Host ports are offset +50000 from the dev stack (see ADR-IMPL.INFRA.
# dev-test-compose-separation) so dev and test stacks run side by side.

# --- Ports (host side, offset +50000 from dev) ---
BACKEND_TEST_PORT=58080
FRONTEND_TEST_PORT=55173
POSTGRES_TEST_PORT=55432
HUB_MOCK_TEST_PORT=58081

# --- PostgreSQL (shared defaults with dev) ---
POSTGRES_USER=edutrack
POSTGRES_PASSWORD=edutrack
POSTGRES_DB=edutrack

# --- Backend ---
APP_ENV=test
LOG_LEVEL=warn
# No telemetry exporter in the test stack.
OTEL_SAMPLING_RATIO=0

# --- Dynamic runtime config (same contract as dev, test ports) ---
PUBLIC_BASE_URL=http://localhost:58080
JWKS_URL=http://localhost:58080/.well-known/jwks.json
VEDO_HUB_API_URL=http://hub-mock:8081
# VEDO_HUB_SPARQL_PATH=/sparql       # путь read-only SPARQL-эндпоинта Hub (по умолчанию /sparql)
# VEDO_MCP_API_KEY=                  # API-ключ MCP-сервера (vedo-edutrack mcp); пусто = без авторизации
JWT_ISSUER=vedo-edutrack
JWT_AUDIENCE=vedo-edutrack
