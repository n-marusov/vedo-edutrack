# VEDO EduTrack dev-stack environment.
#
# Copy to deploy/.env and adjust. Every variable has a default in
# docker-compose.yml, so this file is optional for `docker compose up`.
# Values must be KEY=VALUE (one per line, no quotes) — they are also
# exported into the Makefile environment via `-include .env`.

# --- Ports (host side) ---
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_OTLP_GRPC_PORT=4317
OTEL_OTLP_HTTP_PORT=4318
TRAEFIK_DASHBOARD_PORT=8082

# --- PostgreSQL ---
POSTGRES_USER=edutrack
POSTGRES_PASSWORD=edutrack
POSTGRES_DB=edutrack

# --- Grafana (dev only) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Observability / OTel ---
LOG_LEVEL=debug
OTEL_SAMPLING_RATIO=0.1

# --- Traefik (Let's Encrypt) ---
# ACME_EMAIL=admin@example.com
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
