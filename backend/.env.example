# VEDO EduTrack — Backend Environment
#
# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored; this file is the documented template.

# PostgreSQL connection (local docker-compose default)
DATABASE_URL=postgres://edutrack:edutrack@localhost:5432/edutrack?sslmode=disable

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Server port
PORT=8080

# JWKS endpoint (local Keycloak / mock JWKS)
JWKS_URL=http://localhost:8080/.well-known/jwks.json

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vedo-edutrack-backend
