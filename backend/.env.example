# VEDO EduTrack — Backend Environment
#
# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored; this file is the documented template.

# PostgreSQL connection (local docker-compose default)
DATABASE_URL=postgres://edutrack:edutrack@localhost:5432/edutrack?sslmode=disable

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Server port
PORT=8080

# Deployment environment: development | staging | production
APP_ENV=development

# JWKS endpoint (identity provider public keys)
JWKS_URL=http://localhost:8080/.well-known/jwks.json

# Dev JWT key pair — auto-generated on first start when missing
# (path relative to the backend working directory; git-ignored)
JWKS_PRIVATE_KEY_PATH=./tmp/jwt_key.pem

# JWT issuer/audience for locally-issued dev tokens (must match token claims)
JWT_ISSUER=vedo-edutrack
JWT_AUDIENCE=vedo-edutrack

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vedo-edutrack-backend

# Trace sampling ratio (100% errors + ratio% success; 0..1)
OTEL_SAMPLING_RATIO=0.1

# Externally reachable base URL (webhooks, absolute links)
PUBLIC_BASE_URL=http://localhost:8080

# VEDO Hub REST API base URL (F0 read-only; dev stack uses hub-mock)
VEDO_HUB_API_URL=http://localhost:8081

# Mock VEDO Hub (cmd/mockhub, test-only) — path to the ontology .ttl file
ONTOLOGY_FILE=../traceability.ttl
